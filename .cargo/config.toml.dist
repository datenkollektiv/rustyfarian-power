[build]
target = "xtensa-esp32s3-espidf"
target-dir = "target/ide"

# ESP32-S3 target (Heltec WiFi LoRa 32 V3)
[target.xtensa-esp32s3-espidf]
linker = "ldproxy"
rustflags = ["--cfg", "espidf_time64"]

# ESP32 target (Adafruit ESP32 Feather V2)
[target.xtensa-esp32-espidf]
linker = "ldproxy"
rustflags = ["--cfg", "espidf_time64"]

# ESP32-C3 target (ESP32-C3-DevKitM-1; riscv32imc, no atomics)
[target.riscv32imc-esp-espidf]
linker = "ldproxy"
rustflags = ["--cfg", "espidf_time64"]

# ESP32-S3 bare-metal target (esp-hal tier examples; linkall.x comes from esp-hal)
[target.xtensa-esp32s3-none-elf]
runner = "espflash flash --monitor --chip esp32s3"
rustflags = ["-C", "link-arg=-Tlinkall.x"]

# ESP32-C3 bare-metal target (esp-hal tier examples; linkall.x is required per ADR-001)
[target.riscv32imc-unknown-none-elf]
runner = "espflash flash --monitor --chip esp32c3"
rustflags = ["-C", "link-arg=-Tlinkall.x"]

# ESP32 bare-metal target (esp-hal tier examples; linkall.x comes from esp-hal)
[target.xtensa-esp32-none-elf]
runner = "espflash flash --monitor --chip esp32"
rustflags = ["-C", "link-arg=-Tlinkall.x"]

[unstable]
build-std = ["std", "panic_abort"]

[env]
MCU="esp32s3"
ESP_IDF_VERSION = "v5.3.3"
# Install/reuse the ESP-IDF toolchain in the global ~/.espressif location rather than a
# per-workspace .embuild. Essential when CARGO_TARGET_DIR points at the RAM disk: it keeps
# the multi-GB toolchain on persistent disk (shared with the other rustyfarian repos) and
# off the small, ephemeral RAM disk, which only holds build artefacts.
ESP_IDF_TOOLS_INSTALL_DIR = "global"
